# Lokale Entwicklung gegen die Supabase-Instanz aus `pnpm db:start`.
#
#   pnpm db:env        # schreibt .env.local und setzt die leeren Werte unten ein
#
# Die Schlüssel stehen absichtlich nicht hier, sondern kommen aus der laufenden Instanz
# (siehe scripts/local-env.sh). Port 55321 stammt aus supabase/config.toml ([api] port).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dateispeicher für PDF, XML und Logo. Lokal die S3-Schnittstelle von Supabase Storage (Bucket
# `blitzrechnung` legt supabase/config.toml an). In Produktion stehen hier die Werte von
# Cloudflare R2.
S3_ENDPOINT=http://127.0.0.1:55321/storage/v1/s3
S3_REGION=local
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=blitzrechnung
S3_PUBLIC_URL=http://127.0.0.1:55321/storage/v1/object/public/blitzrechnung

# Optional — ohne diese Werte läuft alles bis auf den E-Mail-Versand:
# AHASEND_API_KEY=
# AHASEND_ACCOUNT_ID=
